              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Notebook.Tab" id="data_tab" named="True">
            <property name="text" translatable="yes">Data Settings</property>
            <child>
              <object class="ttk.Frame" id="data_settings_frame">
                <property name="height">600</property>
                <property name="width">1200</property>
                <layout manager="pack">
                  <property name="expand">true</property>
                  <property name="fill">both</property>
                  <property name="padx">10</property>
