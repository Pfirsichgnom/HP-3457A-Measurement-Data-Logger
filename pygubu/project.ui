                        <property name="onvalue">1</property>
                        <property name="text" translatable="yes">Trigger</property>
                        <property name="variable">int:trig_var</property>
                        <bind sequence="&lt;ButtonPress&gt;" handler="callback" add="True" />
                        <layout manager="pack">
                          <property name="padx">20</property>
                          <property name="pady">5</property>
                          <property name="side">left</property>
                        </layout>
                      </object>
                    </child>
                    <child>
