                      <property name="side">top</property>
                    </layout>
                    <child>
                      <object class="ttk.Checkbutton" id="contsave_checkbox" named="True">
                        <property name="command" type="command" cbtype="simple">cont_checked</property>
                        <property name="offvalue">0</property>
                        <property name="onvalue">1</property>
